      "settings": {
        "custom_liquid": "<div class=\"text-lists\">\n<div class=\"list-1\">\n<ul>\n<li class=\"title\">Guest Services</li>\n<li>Resturants and Cafes</li>\n<li>Hotels, Bnb's & Airbnb's</li>\n</ul>\n</div>\n<div class=\"list-2\">\n<ul>\n<li class=\"title\">Businesses</li>\n<li>Office Programs</li>\n<li>Service Centers</li>\n</ul>\n</div>\n<div class=\"list-3\">\n<ul>\n<li class=\"title\">Shops</li>\n<li>Specialty Retailers</li>\n<li>Grocery Stores</li>\n</ul>\n</div>\n</div>",
