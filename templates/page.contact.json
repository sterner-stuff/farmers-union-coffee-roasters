    "ab4becb8-a343-409e-857c-2b9c4c214ef0": {
      "type": "image-with-text",
      "blocks": {
        "99af47a9-ed47-4eb5-a203-56082dc2fbb3": {
          "type": "heading",
          "settings": {
            "heading": "Specialty Retailers",
            "heading_size": "h1"
          }
        },
        "de69c57b-03b1-4407-a081-4183e176a2b8": {
          "type": "text",
          "settings": {
            "text": "<p>Are you a boutique store looking to give your customers the gift of local? Coffee is one of the most emerging trends on the shelf, and our wholesale programs make it easy for you to get started. We’re here to help you make a difference in your community and provide an incredible <br/>experience for your customers. We have a variety of options available, so whether you’re just starting out or already have an established coffee offering, we have something for you.</p>",
            "text_style": "body"
          }
        },
        "f52bd780-9f59-4f4f-97ef-82a6d067cf2c": {
          "type": "button",
          "settings": {
            "button_label": "More Info",
            "button_link": ""
