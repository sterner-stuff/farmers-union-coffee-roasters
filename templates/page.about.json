        },
        "template--14646129295426__a410f0bd-0dd9-4b6d-90c3-38584dda2319-1685563027d1e98090-1": {
          "type": "text",
          "settings": {
            "text": "<p>Our rooftop solar array is our way of doing right by the environment and our customers. It heats our water and generates electrical power for EWEB in Eugene. This saves water and reduces our carbon footprint.</p>",
            "text_style": "body"
          }
        }
