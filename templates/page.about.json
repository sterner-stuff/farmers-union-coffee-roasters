      "type": "image-with-text",
      "blocks": {
        "template--14646129295426__a410f0bd-0dd9-4b6d-90c3-38584dda2319-1685563027d1e98090-0": {
          "type": "heading",
          "settings": {
            "heading": "We believe that clean, renewable energy is the future.",
            "heading_size": "h1"
