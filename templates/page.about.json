        "2aa0a286-06cf-44b7-b54d-99ab16c40743": {
          "type": "heading",
          "settings": {
            "heading": "We're proud to say that we compost pretty much everything in our cafe.",
            "heading_size": "h1"
          }
        },
        "7dabd83a-8de9-427a-8ac5-de66a23f9b2c": {
          "type": "text",
          "settings": {
            "text": "<p>We're proud to say that we're committed to using every bit of our coffee: from the grounds to the chaff. We compost all of our spent coffee grounds—which go on to make their way into local gardens—and we compost all of our food waste through the city of Eugene's \"Love Food Not Waste\" program.</p>",
            "text_style": "body"
          }
        }
      },
      "block_order": [
