        "5cba6629-fd20-4f86-a618-f65bb3e760d3": {
          "type": "heading",
          "settings": {
            "heading": "If you bring your own cup, we'll give you a discount!",
            "heading_size": "h1"
          }
        },
        "b73b2c20-2080-4cd4-9d61-97b95a0247fb": {
          "type": "text",
          "settings": {
            "text": "<p>It's true! We're trying to get away from single-use plastics, and we want to make it easier for you to do the same. So if you bring your own cup, we'll give you a discount on your coffee!\t\t\t\t\t</p>",
            "text_style": "body"
